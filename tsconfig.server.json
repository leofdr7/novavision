{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "types": ["node"], "strict": true, "skipLibCheck": true, "noEmit": true,
    "verbatimModuleSyntax": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["api", "server", "shared"]
}
