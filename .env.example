# Server only. Copy to .env.local; never use VITE_ for a secret.
# Start with npm run dev:full so Vercel functions inherit this file. Restart after edits.
CHAT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TOKEN_ENCODING=o200k_base
OPENAI_INPUT_USD_PER_1M=0.40
OPENAI_CACHED_INPUT_USD_PER_1M=0.10
OPENAI_OUTPUT_USD_PER_1M=1.60
CHAT_MONTHLY_BUDGET_USD=10
# Local: use the actual origin printed by vercel dev. No trailing slash.
ALLOWED_ORIGIN=http://localhost:3000
# Production: https://www.novavision.com.sv,https://novavision.com.sv
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate two independent random secrets, at least 32 characters each.
CHAT_SESSION_SECRET=
RATE_LIMIT_HASH_SECRET=
